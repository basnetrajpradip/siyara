model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String?
  phone    String?
  avatar   String?
  role     Role    @default(USER)

  firstName String
  lastName  String
  dateOfBirth DateTime?
  address   String?

  provider   String?
  providerId String?
  @@unique([provider, providerId])

  reviews                   Review[]
  cart                      Cart?
  orders                    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}
